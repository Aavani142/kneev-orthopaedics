# ---------------------------------------------------------------------------
# KNEEV landing page configuration. Copy to .env and fill in.
# VITE_* values are PUBLIC (bundled into the browser).
# ---------------------------------------------------------------------------

# --- Public clinic contact details
# CONFIRM WITH CLINIC: these are authorised to receive campaign enquiries.
# VITE_CLINIC_WHATSAPP is used by the WhatsApp buttons (wa.me click-to-chat).
VITE_CLINIC_PHONE=+916366700736
VITE_CLINIC_PHONE_DISPLAY=+91 636 670 0736
# WhatsApp: country code + number, digits only
VITE_CLINIC_WHATSAPP=916366700736
VITE_CLINIC_EMAIL=kneevorthopaediccenter@gmail.com
VITE_CLINIC_MAPS_URL=https://share.google/GduFqF1jzGn6mgBLs
# Google Maps embed (no API key needed). Replace with the clinic's own
# "Share > Embed a map" src for an exact pin.
VITE_CLINIC_MAP_EMBED=https://www.google.com/maps?q=KNEEV+Orthopaedic+Center,+14th+Cross+Rd,+2nd+Block,+Jayanagar,+Bengaluru+560011&output=embed

# --- Popup behaviour (shown once per browser session; ?popup=1 forces it)
VITE_POPUP_DELAY_MS=3000

# --- Google tracking (public IDs)
# The Google Ads tag AW-18111261649 is installed in the <head> of index.html and
# privacy-policy.html, so no variable is needed for it. Conversion labels can be pasted
# into CONVERSION_LABELS in src/services/trackingService.js, or set here instead.
# Leave VITE_GTM_ID empty unless the conversion tags are moved into GTM: when it is set,
# the site stops sending Ads conversions itself and GTM must send them.
VITE_GTM_ID=                      # optional: GTM-XXXXXXX
VITE_GA4_ID=                      # optional: G-XXXXXXXXXX (configured on the same Google tag)
VITE_GOOGLE_ADS_ID=               # optional override; defaults to AW-18111261649
VITE_GOOGLE_ADS_LEAD_LABEL=       # TODO(Google Ads): label – "Submit Lead Form" (enquiry emailed)
VITE_GOOGLE_ADS_CALL_LABEL=       # TODO(Google Ads): label – phone click
VITE_GOOGLE_ADS_WHATSAPP_LABEL=   # TODO(Google Ads): label – WhatsApp click
VITE_GOOGLE_ADS_ENHANCED_CONVERSIONS=false

# ---------------------------------------------------------------------------
# Enquiry email (SERVER-SIDE ONLY – never prefix these with VITE_).
# On Vercel: Project → Settings → Environment Variables (Production + Preview).
# Used by api/lead.js, which sends each enquiry through Resend (https://resend.com).
# ---------------------------------------------------------------------------
RESEND_API_KEY=                   # TODO: re_... from Resend → API Keys (Sending access)
LEAD_EMAIL_TO=kneevorthopaediccenter@gmail.com
# Until a domain is verified in Resend, only onboarding@resend.dev works, and Resend
# then delivers ONLY to the email address that owns the Resend account.
# After verifying kneevorthopaediccenter.com in Resend, use e.g.:
#   LEAD_EMAIL_FROM=Kneev Website <enquiries@kneevorthopaediccenter.com>
LEAD_EMAIL_FROM=Kneev Website <onboarding@resend.dev>
LEAD_ALLOWED_ORIGINS=             # optional, comma-separated extra Origins allowed to post
