# ---------------------------------------------------------------------------
# KNEEV landing page configuration. Copy to .env and fill in.
# VITE_* values are PUBLIC (bundled into the browser).
# Everything else is SERVER-ONLY. Never prefix a secret with VITE_.
# ---------------------------------------------------------------------------

# --- Public clinic contact details
# CONFIRM WITH CLINIC: these are authorised to receive campaign enquiries.
VITE_CLINIC_PHONE=+916366700736
VITE_CLINIC_PHONE_DISPLAY=+91 636 670 0736
# WhatsApp: country code + number, digits only
VITE_CLINIC_WHATSAPP=916366700736
VITE_CLINIC_EMAIL=kneevorthopaediccenter@gmail.com
VITE_CLINIC_MAPS_URL=https://share.google/GduFqF1jzGn6mgBLs
# Google Maps embed (no API key needed). Replace with the clinic's own
# "Share > Embed a map" src for an exact pin.
VITE_CLINIC_MAP_EMBED=https://www.google.com/maps?q=KNEEV+Orthopaedic+Center,+14th+Cross+Rd,+2nd+Block,+Jayanagar,+Bengaluru+560011&output=embed

# --- Popup behaviour (shown once per browser session; ?popup=1 forces it)
VITE_POPUP_DELAY_MS=3000
# Leave empty to use the built-in /api/lead endpoint
VITE_LEAD_ENDPOINT=

# --- Google tracking (public IDs). Use EITHER GTM, OR GA4 + Ads directly.
# With GTM, build GA4/Ads tags on these dataLayer events:
#   generate_lead, consultation_popup_open, phone_click, whatsapp_click, consultation_cta_click
VITE_GTM_ID=                      # TODO(clinic): GTM-XXXXXXX
VITE_GA4_ID=                      # TODO(clinic): G-XXXXXXXXXX
VITE_GOOGLE_ADS_ID=               # TODO(clinic): AW-XXXXXXXXX
VITE_GOOGLE_ADS_LEAD_LABEL=       # TODO(clinic): conversion label – form lead
VITE_GOOGLE_ADS_CALL_LABEL=       # TODO(clinic): conversion label – phone click
VITE_GOOGLE_ADS_WHATSAPP_LABEL=   # TODO(clinic): conversion label – WhatsApp click
VITE_GOOGLE_ADS_ENHANCED_CONVERSIONS=false

# ======================= SERVER-ONLY SECRETS BELOW =========================

# --- Lead storage (JSON Lines file, outside the public web root)
LEAD_STORE_PATH=data/leads.jsonl
LEAD_STORE_DISABLED=false
LEAD_DEDUPE_MINUTES=15

# --- Email notifications. Recipient(s), comma-separated:
LEAD_EMAIL_TO=kneevorthopaediccenter@gmail.com
LEAD_EMAIL_FROM=KNEEV Website <your-sending-address@example.com>
# Option A – SMTP (e.g. Gmail / Google Workspace with an App Password)
SMTP_HOST=                        # TODO(clinic): e.g. smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=                        # TODO(clinic)
SMTP_PASS=                        # TODO(clinic): app password, never your normal password
# Option B – Resend API (used only if SMTP_HOST is empty)
RESEND_API_KEY=

# --- WhatsApp alerts to the clinic via Meta WhatsApp Cloud API (optional)
WHATSAPP_ACCESS_TOKEN=            # TODO(clinic)
WHATSAPP_PHONE_NUMBER_ID=         # TODO(clinic)
WHATSAPP_TO=916366700736
# Approved template, 6 body params: name, mobile, city, treatment, time, source
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0

# --- Optional: forward each lead as JSON to a CRM / Google Apps Script
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# --- Optional: comma-separated list of allowed Origins for /api/lead
ALLOWED_ORIGINS=

# --- Local development only: accept leads without any notification channel
# and print them in the terminal. Ignored when NODE_ENV=production.
LEAD_DEV_ECHO=false
